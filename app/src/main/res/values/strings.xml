    <string name="privacy_heading">Media Sandesh privacy policy</string>
    <string name="privacy_subheading">Your privacy matters to us.</string>
    <string name="privacy_updated">Last updated: 29 September 2026</string>
    <string name="privacy_s1_title">What information do we collect?</string>
    <string name="privacy_s1_p1">No account: The app does not create an account or ask for your name, number or email.</string>
    <string name="privacy_s1_p2">My city: The city you choose is saved only on this phone. The app does not access your location.</string>
    <string name="privacy_s1_p3">Send news: Photos, videos or stories you send go straight to our desk via WhatsApp or email and are used only for editorial review.</string>
    <string name="privacy_s2_title">How is information used?</string>
    <string name="privacy_s2_p1">News: Stories load from mediasandesh.com and videos from YouTube.</string>
    <string name="privacy_s2_p2">Translation: In English mode, stories are translated on the phone or with Google Translate.</string>
    <string name="privacy_s2_p3">Listen and voice search: These use your phone\'s Google speech services.</string>
    <string name="privacy_s2_p4">We never sell any of your personal information.</string>
    <string name="privacy_s3_title">Data kept on your phone</string>
    <string name="privacy_s3_p1">Saved stories, reading history, recent searches and settings stay only on your phone.</string>
    <string name="privacy_s4_title">Your rights</string>
    <string name="privacy_s4_p1">You can clear reading history (My News), recent searches (Search) and the cache (Settings) at any time.</string>
    <string name="privacy_s4_p2">Uninstalling the app removes all of its data from your phone.</string>
    <string name="privacy_s5_title">Contact</string>
    <string name="privacy_s5_p1">For any privacy question, email: mediasandesh4@gmail.com</string>
    <string name="privacy_law_title">Legal compliance</string>
    <string name="privacy_law_body">This policy is written with India\'s Digital Personal Data Protection Act (DPDP Act) in mind.</string>
